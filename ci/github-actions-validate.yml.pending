name: validate
on:
  pull_request:
  push:
    branches: [main]
jobs:
  san-v0:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -r kernel/requirements-dev.txt
      - run: python scripts/validate_all.py
