{
  "$id": "https://san.local/schemas/capability-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_band": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "capability_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,80}$",
      "type": "string"
    },
    "confidentiality": {
      "enum": [
        "public",
        "network",
        "derived-only"
      ]
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "minLength": 10,
      "type": "string"
    },
    "evidence_maturity": {
      "enum": [
        "declared",
        "installed",
        "sandbox-tested",
        "task-proven",
        "monitored",
        "outcome-calibrated"
      ]
    },
    "rollback": {
      "minLength": 5,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "tests": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "version",
    "description",
    "confidentiality",
    "authority_band",
    "artifacts",
    "tests",
    "rollback"
  ],
  "title": "Capability Manifest",
  "type": "object"
}
