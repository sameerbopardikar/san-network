{
  "$id": "https://san.local/schemas/capability-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "exact_pin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "git-commit",
            "manifest-sha256",
            "release",
            "none"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git-commit"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "manifest-sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "none"
              }
            }
          }
        }
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_band": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "capability_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,80}$",
      "type": "string"
    },
    "corpus_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "description": {
      "minLength": 10,
      "type": "string"
    },
    "evidence_maturity": {
      "enum": [
        "declared",
        "installed",
        "sandbox-tested",
        "task-proven",
        "monitored",
        "outcome-calibrated"
      ]
    },
    "explicit_non_claims": {
      "items": {
        "minLength": 3,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "kernel_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "rollback": {
      "minLength": 5,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "planned-not-released",
        "released",
        "deprecated",
        "revoked"
      ]
    },
    "tests": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "audience": {
      "enum": [
        "public",
        "network",
        "bilateral",
        "owner-private"
      ]
    },
    "handling_constraints": {
      "items": {
        "enum": [
          "derived-only",
          "confidential-source",
          "secret"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "installed",
              "sandbox-tested",
              "task-proven",
              "monitored",
              "outcome-calibrated"
            ]
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "uri": {
            "format": "uri-reference",
            "minLength": 1,
            "type": "string"
          },
          "actor": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^agent:[a-z0-9][a-z0-9-]{1,62}$"
              },
              {
                "type": "string",
                "pattern": "^github:[A-Za-z0-9-]{1,39}$"
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "abstain",
              "go",
              "no-go"
            ]
          },
          "environment_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 digest of the exact environment/tooling set used for the evidence event."
          }
        },
        "required": [
          "kind",
          "uri",
          "sha256",
          "actor",
          "timestamp",
          "verdict",
          "environment_digest"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "version",
    "status",
    "description",
    "audience",
    "handling_constraints",
    "authority_band",
    "kernel_pin",
    "corpus_pin",
    "evidence_maturity",
    "tests",
    "rollback",
    "explicit_non_claims"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "kernel_pin": {
            "properties": {
              "kind": {
                "const": "git-commit"
              }
            }
          },
          "evidence": {
            "minItems": 1
          }
        },
        "required": [
          "artifacts",
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_maturity": {
            "const": "installed"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "installed"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_maturity": {
            "const": "sandbox-tested"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "sandbox-tested"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_maturity": {
            "const": "task-proven"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "task-proven"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_maturity": {
            "const": "monitored"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "monitored"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_maturity": {
            "const": "outcome-calibrated"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "outcome-calibrated"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "evidence"
        ]
      }
    }
  ],
  "title": "Capability Manifest",
  "type": "object"
}
