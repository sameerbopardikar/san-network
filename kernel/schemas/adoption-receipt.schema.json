{
  "$id": "https://san.local/schemas/adoption-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "agent_id": {
      "pattern": "^agent:[a-z0-9][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "exact_pin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "git-commit",
            "manifest-sha256",
            "release",
            "none"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git-commit"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "manifest-sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "none"
              }
            }
          }
        }
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,100}$",
      "type": "string"
    },
    "benchmark_result": {
      "enum": [
        "passed",
        "failed",
        "not-run"
      ]
    },
    "benchmark_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "candidate_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "claims": {
      "items": {
        "enum": [
          "installed",
          "sandbox-tested",
          "task-proven",
          "monitored",
          "outcome-calibrated"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "destination_agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "deviations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "event_type": {
      "enum": [
        "adopt",
        "reject",
        "promote",
        "demote",
        "rollback",
        "rollback-failed",
        "revoke"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "subject_pin",
          "actor",
          "timestamp",
          "environment_digest",
          "verdict"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri-reference",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "subject_pin": {
            "$ref": "#/$defs/exact_pin"
          },
          "actor": {
            "$ref": "#/$defs/agent_id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "environment_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verdict": {
            "enum": ["pass", "fail"]
          }
        }
      }
    },
    "evidence_maturity": {
      "enum": [
        "declared",
        "installed",
        "sandbox-tested",
        "task-proven",
        "monitored",
        "outcome-calibrated"
      ]
    },
    "executor_agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "observed_result": {
      "minLength": 1,
      "type": "string"
    },
    "previous_baseline_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "receipt_id": {
      "pattern": "^receipt:[a-z0-9][a-z0-9-]{1,120}$",
      "type": "string"
    },
    "result": {
      "enum": [
        "accepted",
        "rejected",
        "rolled-back",
        "revoked"
      ]
    },
    "resulting_baseline_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "reviewer_agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "rollback_target_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "rollback_verified": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1
    },
    "subject_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,100}$",
      "type": "string"
    },
    "subject_pin": {
      "$ref": "#/$defs/exact_pin"
    },
    "tested_at": {
      "format": "date-time",
      "type": "string"
    },
    "threshold": {
      "minLength": 1,
      "type": "string"
    },
    "verifier_agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "demotion_reason": {
      "minLength": 3,
      "type": "string"
    },
    "revocation_reason": {
      "minLength": 3,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "event_type",
    "subject_id",
    "subject_pin",
    "destination_agent_id",
    "executor_agent_id",
    "reviewer_agent_id",
    "verifier_agent_id",
    "benchmark_id",
    "benchmark_version",
    "benchmark_result",
    "threshold",
    "observed_result",
    "previous_baseline_pin",
    "candidate_pin",
    "resulting_baseline_pin",
    "rollback_target_pin",
    "result",
    "tested_at",
    "evidence",
    "evidence_maturity",
    "rollback_verified",
    "claims",
    "deviations"
  ],
  "title": "Adoption and Promotion Receipt",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "adopt",
              "promote"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "benchmark_result": {
            "const": "passed"
          },
          "result": {
            "const": "accepted"
          },
          "rollback_verified": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "reject"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "rejected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "rollback"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "rolled-back"
          },
          "rollback_verified": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "rollback-failed"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "rejected"
          },
          "rollback_verified": {
            "const": false
          },
          "resulting_baseline_pin": {
            "properties": {
              "kind": {
                "const": "none"
              },
              "value": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "demote"
          }
        }
      },
      "then": {
        "required": [
          "demotion_reason"
        ],
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "result": {
                "const": "rolled-back"
              },
              "rollback_verified": {
                "const": true
              }
            },
            "required": [
              "result",
              "rollback_verified"
            ]
          },
          {
            "type": "object",
            "properties": {
              "result": {
                "const": "rolled-back"
              },
              "rollback_verified": {
                "const": false
              },
              "resulting_baseline_pin": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "none"
                  },
                  "value": {
                    "const": "none"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ]
              }
            },
            "required": [
              "result",
              "rollback_verified",
              "resulting_baseline_pin"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "revoke"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "revoked"
          },
          "resulting_baseline_pin": {
            "properties": {
              "kind": {
                "const": "none"
              },
              "value": {
                "const": "none"
              }
            }
          }
        },
        "required": [
          "revocation_reason"
        ]
      }
    }
  ]
}
