{
  "$id": "https://san.local/schemas/corpus-release.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "concept",
              "source-card",
              "synthesis",
              "manifest",
              "eval",
              "blob-pointer"
            ]
          },
          "origin": {
            "minLength": 3,
            "type": "string"
          },
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
            "type": "string"
          },
          "release_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "rights_basis": {
            "minLength": 3,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "pattern": "^[a-z0-9][a-z0-9-]{1,100}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "transform_chain": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "source_ids",
          "origin",
          "rights_basis",
          "transform_chain",
          "release_version"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "confidentiality": {
      "enum": [
        "public",
        "network",
        "bilateral"
      ]
    },
    "corpus_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,80}$",
      "type": "string"
    },
    "exclusions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "external_blobs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "uri": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "uri",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "released_at": {
      "format": "date-time",
      "type": "string"
    },
    "rights_policy": {
      "minLength": 3,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_count": {
      "minimum": 1,
      "type": "integer"
    },
    "title": {
      "minLength": 3,
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "title",
    "confidentiality",
    "rights_policy",
    "released_at",
    "source_count",
    "artifacts",
    "exclusions",
    "external_blobs"
  ],
  "title": "Corpus Release",
  "type": "object"
}
